# Secrets and local environment — never commit
.env
.env.*
!.env.example
*.local

# Jekyll / GitHub Pages build output (docs/)
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/.sass-cache/
.bundle/
vendor/

# Node (e.g. MCP servers pulled via npx)
node_modules/
npm-debug.log*

# Logs and temp files
*.log
*.tmp
